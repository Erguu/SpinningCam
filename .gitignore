# EMS license signing — NEVER commit the private key or generated licenses
license_private_key.pem
*.pem
*.lic

# Python
__pycache__/
*.pyc

# Build artifacts
build/
dist/
Build_exe_output.txt

# Logs & dev scratch (local only)
*.log
backup/
images/
crash_output.txt
latestchanges.txt

# Claude Code local settings
.claude/settings.local.json
ops_library.json

# Per-user runtime state — the app REWRITES this constantly (params, camera,
# sidebar width, language, license/admin flags), so tracking it makes every
# `git pull` collide with each user's local changes. Untracked: the app rebuilds
# it from code defaults (main.py load_settings) when it is absent.
settings.json

# Runtime-owned DATA (Phase 2 pull fix): the app rewrites these on tool edits /
# calibration, so tracking them collides on `git pull`. The LIVE files are ignored;
# the tracked `*.default.json` SEEDS ship instead and first_run_seed.py copies a
# seed -> live file on first launch when the live one is missing.
tools.json
machines/*.json
!machines/*.default.json

# Leftovers from migrate_before_pull.bat / the manual migration (local only)
migration_backup_*/
*.mine.json

# Tool geometry. The folder does two jobs: it holds the SEED shapes that ship
# with the app (they pair with tools.default.json, which names T0101-T0103), and
# it holds whatever tools the user has built for themselves. Only the seed is
# source — a user's own library is local data, same rule as tools.json and
# machines/*.json, and it travels by the zip Export/Import in tool_library_io.py,
# not by git. So: ignore the folder, then re-admit the three seed files.
tool_geometry/*
!tool_geometry/T0101.STEP
!tool_geometry/T0102.STEP
!tool_geometry/T0103.STEP

# Personal CAD inputs & saved programs (user work products, not source). These
# used to show up as untracked noise on every push. NOTE the leading slash: only
# ROOT-level part/mandrel models are ignored (tool_geometry is handled above).
/*.STEP
/*.step
/*.stp
/*.STP
*.ssp
!deneme_mandrel.ssp   # keep the tracked example program
